{
  "uid": "garden-telemetria",
  "title": "Telemetria",
  "tags": [
    "garden-iot"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "garden-timescaledb"
        },
        "query": "SELECT DISTINCT tenant_id FROM telemetry.reading ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Nó",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "garden-timescaledb"
        },
        "query": "SELECT DISTINCT node_id FROM telemetry.reading WHERE tenant_id IN ($tenant) ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "offline_after",
        "label": "Offline após",
        "type": "custom",
        "query": "1m,5m,15m,1h",
        "current": {
          "text": "5m",
          "value": "5m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": true
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nós online",
      "description": "Nós com lote gravado dentro do intervalo escolhido (offline_after).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(DISTINCT node_id) AS online FROM telemetry.reading WHERE ingested_at > now() - '${offline_after}'::interval AND tenant_id IN ($tenant)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Atraso p99 (leitura até gravação)",
      "description": "p99 de ingested_at menos read_at na janela. SLO: 99% em menos de 10 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT percentile_cont(0.99) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - read_at)) AS p99 FROM telemetry.reading WHERE $__timeFilter(ingested_at) AND tenant_id IN ($tenant)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Atraso p99 ao longo do tempo",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ingested_at, $__interval), percentile_cont(0.99) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - read_at)) AS p99 FROM telemetry.reading WHERE $__timeFilter(ingested_at) AND tenant_id IN ($tenant) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Leituras por nó e sensor (contagem por intervalo)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(read_at, $__interval), node_id || '/' || kind AS metric, count(*) AS leituras FROM telemetry.reading WHERE $__timeFilter(read_at) AND tenant_id IN ($tenant) AND node_id IN ($node) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Umidade do solo (%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(read_at, $__interval), node_id AS metric, avg(value) AS value FROM telemetry.reading WHERE $__timeFilter(read_at) AND kind = 'soil_moisture_vwc_pct' AND tenant_id IN ($tenant) AND node_id IN ($node) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperatura do ar (°C)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(read_at, $__interval), node_id AS metric, avg(value) AS value FROM telemetry.reading WHERE $__timeFilter(read_at) AND kind = 'air_temp_c' AND tenant_id IN ($tenant) AND node_id IN ($node) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Umidade do ar (%)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(read_at, $__interval), node_id AS metric, avg(value) AS value FROM telemetry.reading WHERE $__timeFilter(read_at) AND kind = 'air_humidity_pct' AND tenant_id IN ($tenant) AND node_id IN ($node) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Luz (lux)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "garden-timescaledb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lux"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "garden-timescaledb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(read_at, $__interval), node_id AS metric, avg(value) AS value FROM telemetry.reading WHERE $__timeFilter(read_at) AND kind = 'illuminance_lux' AND tenant_id IN ($tenant) AND node_id IN ($node) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    }
  ]
}