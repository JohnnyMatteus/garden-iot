# Simulação (Wokwi): Wi-Fi aberto do simulador, broker sem TLS, ciclo curto.
CONFIG_GARDEN_WIFI_SSID="Wokwi-GUEST"
CONFIG_GARDEN_WIFI_PASSWORD=""
CONFIG_GARDEN_MQTT_URI="mqtt://broker.emqx.io:1883"
CONFIG_GARDEN_ALLOW_INSECURE_MQTT=y
CONFIG_GARDEN_TENANT="ci"
CONFIG_GARDEN_HORTA="wokwi"
CONFIG_GARDEN_NODE_ID="no-sim-01"
CONFIG_GARDEN_CYCLE_SECONDS=30
