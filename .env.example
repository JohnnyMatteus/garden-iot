# Copie para .env (ignorado pelo git). Valores de desenvolvimento: nunca usar em produção.
COMPOSE_PROJECT_NAME=garden-iot

# Portas no host (mude se houver conflito com outros projetos)
EMQX_MQTTS_PORT=8883
EMQX_DASHBOARD_PORT=18083
KAFKA_EXTERNAL_PORT=29092
SCHEMA_REGISTRY_PORT=8081
TIMESCALEDB_PORT=5432
GRAFANA_PORT=3000
VAULT_PORT=8200
KAFKA_UI_PORT=8089

# Vault em modo dev (token fixo, dados em memória)
VAULT_DEV_ROOT_TOKEN_ID=dev-only-change-me

# EMQX
EMQX_DASHBOARD_PASSWORD=dev-only-change-me

# TimescaleDB: dono do schema e papéis de aplicação
POSTGRES_DB=garden
POSTGRES_USER=garden_owner
POSTGRES_PASSWORD=dev-only-change-me
TELEMETRY_WRITER_PASSWORD=dev-only-change-me
TELEMETRY_OPS_PASSWORD=dev-only-change-me
GARDEN_API_PASSWORD=dev-only-change-me

# Grafana
GRAFANA_ADMIN_PASSWORD=dev-only-change-me

# Certificados emitidos pelo Vault (make pki) ficam em infra/pki/out
PKI_OUT_DIR=./infra/pki/out
